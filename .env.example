# Reference list of every environment variable used by the project.
# Real values live in untracked files: backend/.env and frontend/.env.local.
# Never commit populated .env files.

# --- Backend (backend/.env) ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://chess:change-me@localhost:5432/chess_dev
JWT_SECRET_KEY=generate-with-python-secrets-token_urlsafe-48
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173"]
# Optional gameplay tuning (defaults shown)
MATCHMAKING_STALE_SECONDS=15
GAME_START_TIMEOUT_SECONDS=60
WS_IDLE_TIMEOUT_SECONDS=60
# Abuse limits. Behind proxies, set CLIENT_IP_HEADER (see docs/DEPLOYMENT.md) or else
# TRUSTED_PROXY_HOPS, the number of proxies in front of the API.
CLIENT_IP_HEADER=
AUTH_RATE_LIMIT_PER_MINUTE=20
TRUSTED_PROXY_HOPS=0

# --- Frontend (frontend/.env.local) ---
VITE_API_BASE_URL=http://localhost:8000

# --- Docker Compose (.env next to docker-compose.yml) ---
POSTGRES_PASSWORD=choose-letters-and-digits
# JWT_SECRET_KEY (above) is also required.
# BACKEND_PORT=8000
# FRONTEND_PORT=8080
